[gd_resource type="Theme" load_steps=6 format=3 uid="uid://ccavetheme01"]

; =============================================================================
; AllegoryCave Menu Theme — Persona 5 flavor
; -----------------------------------------------------------------------------
; Bold, angular, high-contrast. Jet-black plates with a thick chalk-white
; border and blood-red accent bar. On hover, the plate flips to blood red
; with white text — snappy and aggressive. Buttons are also rotated slightly
; in the scene for that slanted-poster feel.
; =============================================================================

